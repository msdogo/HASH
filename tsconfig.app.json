{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "tests/overview-buttons.test.tsx", "tests/component-wiring.test.tsx", "tests/settings-page.test.tsx", "tests/app-nav.test.tsx", "tests/store-wiring.test.ts", "tests/drag-store.test.ts", "tests/double-click-wiring.test.ts", "tests/transfer-dock-notice.test.tsx", "tests/apps-page.test.tsx", "tests/log-bar.test.tsx", "tests/log-store.test.ts", "tests/window-controls.test.tsx", "tests/mirror-window.test.tsx"]
}
