{
  "name": "adb-file-manager",
  "version": "0.10.5",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "fetch-platform-tools": "node scripts/fetch-platform-tools.mjs",
    "assert-platform-tools": "node scripts/assert-platform-tools.mjs",
    "fetch-scrcpy": "node scripts/fetch-scrcpy.mjs",
    "assert-scrcpy": "node scripts/assert-scrcpy.mjs",
    "bump": "node scripts/bump-version.mjs",
    "assert-version": "node scripts/assert-version.mjs",
    "dist": "npm run fetch-platform-tools && npm run assert-platform-tools && npm run fetch-scrcpy && npm run assert-scrcpy && npm run assert-version && npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "electron-store": "^12.0.0",
    "koffi": "^2.16.4",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
