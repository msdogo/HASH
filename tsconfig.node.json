{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "electron"],
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["electron", "tests", "src/shared", "vite.config.ts", "vitest.config.ts"],
  /*
   * 渲染期用例（.tsx）必须有 DOM lib 与 jsx，属于 tsconfig.app；
   * 两个工程都收它会触发 TS6307（同一文件属于两个 composite 工程）。
   */
  "exclude": ["tests/overview-buttons.test.tsx", "tests/component-wiring.test.tsx", "tests/settings-page.test.tsx", "tests/app-nav.test.tsx", "tests/store-wiring.test.ts", "tests/drag-store.test.ts", "tests/log-store.test.ts", "tests/double-click-wiring.test.ts", "tests/transfer-dock-notice.test.tsx", "tests/apps-page.test.tsx", "tests/log-bar.test.tsx", "tests/window-controls.test.tsx", "tests/mirror-window.test.tsx", "tests/mirror-store.test.ts"]
}
